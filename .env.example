# Database Configuration
POSTGRES_USER=bizpilot
POSTGRES_PASSWORD=bizpilot_secret
POSTGRES_DB=bizpilot_db
DATABASE_URL=postgresql+asyncpg://bizpilot:bizpilot_secret@localhost:5432/bizpilot_db
# For SQLite local fallback:
# DATABASE_URL=sqlite+aiosqlite:///./bizpilot.db

# Redis & Celery
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Security & Authentication
SECRET_KEY=bizpilot_super_secret_jwt_key_2026_enterprise_production_ready
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Application Settings
PROJECT_NAME="BizPilot Enterprise ERP"
ENVIRONMENT=development
LOG_LEVEL=INFO
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://localhost", "http://127.0.0.1:5173"]
